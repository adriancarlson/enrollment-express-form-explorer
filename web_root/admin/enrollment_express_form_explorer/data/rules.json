~[tlist_sql;
    WITH rule_rows AS (
        SELECT
            u_fb_form.id AS form_id,
            TRIM(u_fb_form.form_title) AS form_title,
            u_fb_form.use_by_school_sharing,
            u_fb_form_sharing.id AS sharing_rule_id,
            u_fb_form_sharing.share_type,
            u_fb_form_sharing.share_permission AS field_or_permission,
            u_fb_form_sharing.share_comparator,
            u_fb_form_sharing.share_value,
            u_fb_form_sharing.edit_form
        FROM u_fb_form
        INNER JOIN u_fb_form_sharing
            ON u_fb_form_sharing.form_id = u_fb_form.id
        WHERE LOWER(TRIM(u_fb_form.enrollmentformcheck)) = 'true'
    )
    SELECT COALESCE(
        JSON_ARRAYAGG(
            JSON_OBJECT(
                'form_id' VALUE rule_rows.form_id,
                'form_title' VALUE rule_rows.form_title,
                'use_by_school_sharing' VALUE rule_rows.use_by_school_sharing,
                'sharing_rule_id' VALUE rule_rows.sharing_rule_id,
                'share_type' VALUE rule_rows.share_type,
                'field_or_permission' VALUE rule_rows.field_or_permission,
                'share_comparator' VALUE rule_rows.share_comparator,
                'share_value' VALUE rule_rows.share_value,
                'edit_form' VALUE rule_rows.edit_form
                NULL ON NULL
                RETURNING CLOB
            )
            ORDER BY rule_rows.form_title, rule_rows.form_id, rule_rows.share_type, rule_rows.sharing_rule_id
            RETURNING CLOB
        ),
        TO_CLOB(CHR(91) || CHR(93))
    ) AS json_result
    FROM rule_rows
;]~(data)[/tlist_sql]
